{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build:dev",
      "problemMatcher": "$esbuild",
      "group": "build",
      "label": "npm: build:dev",
      "detail": "Development build (node target) via esbuild."
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": "$esbuild-watch",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: watch",
      "detail": "Rebuild the node target on change via esbuild."
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": "build",
      "label": "npm: compile",
      "detail": "Type-check the project with tsc --noEmit."
    }
  ]
}
